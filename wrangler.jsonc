{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spellcast-lobby",
  "main": "server/index.ts",
  "compatibility_date": "2026-05-03",
  "durable_objects": {
    "bindings": [
      {
        "name": "SpellRoom",
        "class_name": "SpellRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SpellRoom"]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ]
}
